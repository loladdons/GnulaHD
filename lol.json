{
  "id": "gnulahd",
  "name": "GnulaHD",
  "version": "9.0.0-app",
  "description": "Películas, series y anime en HD (GnulaHD). Home con slider Destacados, filas de catálogo, Descubrir (grillas Películas/Series/Anime), búsqueda y servidores Vidara/Savefiles.",
  "author": "adaptado",
  "entry": "plugin.js",
  "icon": "icon.png",
  "color": "#FF7A18",
  "languages": ["es"],
  "capabilities": ["home", "search", "meta", "streams", "catalog", "discover", "news"],
  "sectionLabel": "GnulaHD",
  "config": [
    {
      "key": "preferredLang",
      "label": "Idioma preferido",
      "type": "select",
      "default": "latino",
      "options": [
        { "label": "Latino", "value": "latino" },
        { "label": "Castellano", "value": "castellano" },
        { "label": "Subtitulado", "value": "subtitulado" }
      ]
    }
  ]
}
